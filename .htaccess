# Bloquea el acceso directo por navegador a carpetas y archivos internos (F-008)
Options -Indexes

# Carpetas que solo se incluyen desde PHP o no deben publicarse
RedirectMatch 403 ^/?(.*/)?(config|sql|herramientas|docs|logs|tests|php/comun|php/partials)/
# php/auth/: todo es librería salvo los tres endpoints (login, logout, estado).
# Un archivo nuevo en php/auth/ queda bloqueado hasta que se agregue aquí.
RedirectMatch 403 ^/?(.*/)?php/auth/(?!(login|logout|estado)\.php$)[^/]*\.php$
# Archivos y carpetas ocultos: .git/, .github/, .env, .htaccess, .gitignore…
RedirectMatch 403 (?i)/\.(git|env|ht)
# Documentación, scripts y logs sueltos (README.md, *.sql, *.sh, *.yml…)
RedirectMatch 403 (?i)\.(md|sql|log|sh|yml|example\.php)$
