# Finales de línea LF en el repositorio y en la copia de trabajo
# (los scripts .sh deben tener LF para correr en Git Bash y en CI)
* text=auto eol=lf
*.png binary
*.jpg binary
*.ico binary

# Lo que NO entra en el paquete de despliegue (git archive, F-018)
/docs          export-ignore
/sql           export-ignore
/herramientas  export-ignore
/tests         export-ignore
/.github       export-ignore
README.md      export-ignore
.gitattributes export-ignore
.gitignore     export-ignore
