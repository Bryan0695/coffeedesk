# ==============================
# CoffeeDesk - Git Ignore
# ==============================

# Documentación interna / auditorías
docs/audits/
docs/evidencias/

# Logs
logs/*
!logs/.gitkeep
!logs/.htaccess

# Credenciales reales
config/credenciales.php

# Archivos de entorno
.env
.env.*
!.env.example

# Archivos temporales
*.tmp
*.temp
*.bak
*.swp

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# IDE / editores
.vscode/*
!.vscode/settings.json
.idea/

# PHP
*.cache

# Cobertura / testing generado
coverage/

# Node, por si posteriormente se agrega frontend con npm
node_modules/

# Builds
dist/
build/

# Documentación local opcional
.docs/
